# Vercel Blob Storage Token
# Obtenido desde el dashboard de Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here

# Wompi Payments
# Credenciales para integración con Wompi
# Sandbox:    pub_test_* / prv_test_* / test_integrity_* / test_events_*
# Producción:  pub_prod_* / prv_prod_* / prod_integrity_* / prod_events_*
WOMPI_PUBLIC_KEY=your_wompi_public_key_here
WOMPI_PRIVATE_KEY=your_wompi_private_key_here
WOMPI_INTEGRITY_SECRET=your_wompi_integrity_secret_here
WOMPI_EVENT_SECRET=your_wompi_event_secret_here
WOMPI_REDIRECT_URL=https://ventas-ya.vercel.app/checkout/confirm

# Secret para endpoint interno de limpieza de reservas expiradas.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLEANUP_SECRET=your_cleanup_secret_here